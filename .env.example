# ClassConnect — environment variables reference
#
# This file is documentation only — it is never loaded automatically.
# The backend and frontend are separate deployments (Render + Vercel) with
# their own environment variable settings; each variable below is consumed
# by exactly one of them, as noted.

# ── Backend (Spring Boot on Render) ──────────────────────────────────────
# Set these as real environment variables in the Render dashboard
# (Environment tab), not in a file — Spring Boot reads them from the
# process environment at startup.

# MongoDB Atlas connection string. Create a free cluster at mongodb.com/atlas,
# add a database user, and allow network access from 0.0.0.0/0 (or Render's
# specific egress IPs) so Render can reach it.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/classconnect?retryWrites=true&w=majority

# The deployed Vercel frontend URL, so the backend's CORS policy allows it.
# Leave unset for local development (localhost origins are always allowed).
FRONTEND_URL=https://your-app.vercel.app

# Secret key used to sign JWTs. Optional — falls back to a built-in demo
# value if unset, but you should set a real one for a public deployment,
# since anyone who reads the source code knows the default.
JWT_SECRET=replace-with-a-long-random-string

# Render sets this automatically — do not set it yourself.
# PORT=10000

# ── Frontend (Vite on Vercel) ─────────────────────────────────────────────
# Set this as a real environment variable in the Vercel dashboard
# (Project Settings → Environment Variables), or edit frontend/.env.production
# directly for a local production build. Vite only exposes variables
# prefixed with VITE_ to client-side code.

# Base URL of the deployed backend (no trailing slash, no /api suffix).
VITE_API_URL=https://your-render-backend-url.onrender.com
